load("//vendor/amlogic/bt-modules:defs.bzl", "btmtk_usb_module")
load("//vendor/amlogic/devices/kleaf:device.bzl", "amlogic_kernel_device")
load("//vendor/amlogic/mtk-drivers/mt7663u/wlan_driver:defs.bzl", "mt7663u_module")

package(
    default_visibility = ["//visibility:public"],
)

btmtk_usb_module(name = "bt_btmtk_usb", kernel_build = ":jaws")

